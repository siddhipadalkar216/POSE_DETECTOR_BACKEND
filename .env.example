# Use a fresh random value of at least 32 characters in production.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=production
AUTH_TOKEN_TTL_SECONDS=2592000

# Use a persistent PostgreSQL URL. For a Vercel-hosted API, use the provider's external URL.
DATABASE_URL=postgresql://user:password@host:5432/database

# Comma-separated exact origins; no trailing slash.
CORS_ORIGINS=https://pose-detector-frontend.onrender.com

# Optional managed AI voice provider. Keep this key only in the backend host environment.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3

# Optional: use a self-hosted OpenAI-compatible Svara TTS endpoint instead of Sarvam.
TTS_API_URL=
TTS_HEALTH_URL=
TTS_API_KEY=
TTS_MODEL=svara-tts-v1
